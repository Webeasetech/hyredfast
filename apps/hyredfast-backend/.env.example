# Port the Hono backend server runs on
PORT=8100

# Publicly reachable base URL of this backend.
# Embedded in the open-tracking pixel of sent emails, so it must be reachable
# from recipients' mail clients. Prod: https://api.your-domain.com
TRACKING_BASE_URL=http://localhost:8100

# Redis connection (used by BullMQ for job queues)
# In Docker, set REDIS_HOST=redis (the service name)
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL connection string (Neon, Supabase, or local)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Encrypts stored SMTP/IMAP passwords (AES-256-GCM). Must be the SAME value the
# frontend uses, or the workers cannot decrypt what the app wrote.
# Generate with: openssl rand -base64 32
# Rotating this makes every stored credential undecryptable.
CREDENTIAL_ENC_KEY=
