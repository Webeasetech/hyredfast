// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Generated client is re-exported from this package
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Users
// ==========================================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  name      String?
  avatar    String?
  timezone  String?
  // The billing meter. One credit is one email sent, debited in the same
  // transaction that advances the lead's stage. This is the ONLY thing that
  // limits sending — there is no company allowance any more.
  credits   Int      @default(0)
  // Retained but inert: nothing decrements it while the AI features are off.
  aiCredits Float?   @default(0) @map("ai_credits")
  // A plan grants a lump of credits and an expiry date. Credits do not refill
  // monthly — they are spent down, and unspent ones die with the term.
  planId        String?   @map("plan_id")
  planStartedAt DateTime? @map("plan_started_at")
  planExpiresAt DateTime? @map("plan_expires_at")
  isSetup   Boolean  @default(false) @map("is_setup")
  // Product walkthrough (react-joyride tour) — shown while false, flipped true
  // once the user completes, skips, or closes it, so it never shows again.
  tourCompleted Boolean @default(false) @map("tour_completed")
  password  String?
  verified  Boolean  @default(false)
  created   DateTime @default(now())
  updated   DateTime @updatedAt

  millionVerifierApiKey String? @map("million_verifier_api_key")

  campaigns          Campaign[]
  emailCredentials   EmailCredential[]
  creditTransactions CreditTransaction[]
  leadLists          LeadList[]
  leadDrafts         LeadDraft[]
  savedLeads         SavedLead[]
  chatMessages       AgentChatMessage[]
  payments           Payment[]
  profile            UserProfile?
  companies          Company[]

  @@map("users")
}

// Answers to the signup questionnaire. Kept off User on purpose: User is read
// on every send, these fields are only read by the agent and by segmentation,
// and this is the table that will keep growing as we ask more.
//
// Every field is nullable or an empty array — each question is skippable, and a
// user who skips the lot still gets a row, so "answered nothing" and "never
// onboarded" stay distinguishable.
model UserProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Presets plus anything the user typed themselves, so this stays free-form
  // rather than a constrained set.
  targetRoles String[] @map("target_roles")

  // INTERN | JUNIOR | MID | SENIOR | LEAD
  seniority String?

  // FULL_TIME | INTERNSHIP | CONTRACT | FREELANCE | PART_TIME
  employmentTypes String[] @map("employment_types")

  country   String?
  city      String?
  // REMOTE | HYBRID | ONSITE
  workModes String[] @map("work_modes")
  willRelocate Boolean? @map("will_relocate")
  // Needs visa sponsorship to work where they are targeting. The single
  // strongest predictor of whether outreach abroad is worth sending at all.
  needsSponsorship Boolean? @map("needs_sponsorship")

  // ACTIVELY_LOOKING | NOTICE_SERVED | LAID_OFF | PASSIVE
  urgency String?
  // FINDING_CONTACTS | WRITING_EMAILS | NO_REPLIES | NO_INTERVIEWS
  blockers String[]

  // The uploaded résumé is parsed and the bytes are dropped on the same
  // request — there is no résumé file at rest anywhere. Only these extracted
  // fields survive.
  resumeParsed   Json?     @map("resume_parsed")
  resumeFileName String?   @map("resume_file_name")
  resumeParsedAt DateTime? @map("resume_parsed_at")

  completedAt DateTime? @map("completed_at")
  created     DateTime  @default(now())
  updated     DateTime  @updatedAt

  @@map("user_profiles")
}

// ==========================================
// Payments (Razorpay)
// ==========================================

// One row per checkout attempt, created before the user ever sees the Razorpay
// modal. `razorpayPaymentId` is unique, which is what makes fulfilment
// idempotent: the client callback and the webhook race, and only one wins.
model Payment {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  razorpayOrderId   String  @unique @map("razorpay_order_id")
  razorpayPaymentId String? @unique @map("razorpay_payment_id")

  planId           String  @map("plan_id") // "quarterly" | "topup"
  creditsGranted   Int     @map("credits_granted")
  amount           Int // paise, GST-inclusive
  currency         String  @default("INR")
  // CREATED | PAID | FAILED | REFUNDED
  status           String  @default("CREATED")
  method           String? // upi | card | netbanking
  failureReason    String? @map("failure_reason")
  notes            Json?

  fulfilledAt DateTime? @map("fulfilled_at")
  created     DateTime  @default(now())
  updated     DateTime  @updatedAt

  events PaymentEvent[]

  @@index([userId])
  @@map("payments")
}

// Raw webhook log. Razorpay sends `x-razorpay-event-id` and retries on
// non-2xx, so the unique index turns a redelivery into a no-op at the door,
// before any business logic runs.
model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String?  @map("payment_id")
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  eventId   String @unique @map("event_id")
  eventType String @map("event_type")
  payload   Json

  created DateTime @default(now())

  @@map("payment_events")
}

// ==========================================
// Campaigns
// ==========================================
model Campaign {
  id                  String           @id @default(cuid())
  title               String?
  userId              String?          @map("user_id")
  user                User?            @relation(fields: [userId], references: [id])
  maxStageCount       Int?             @map("max_stage_count")
  status              String?          @default("PENDING")
  daysInterval        Int?             @map("days_interval")
  setupComplete       Boolean          @default(false) @map("setup_complete")
  desc                String?          @db.Text
  emailDeliveryPeriod String?          @map("email_delivery_period")
  ignoreVerification  Boolean          @default(false) @map("ignore_verification")
  deleted             Boolean          @default(false)
  dynamicSubject      Boolean          @default(false) @map("dynamic_subject")
  isTrackingEnabled   Boolean          @default(false) @map("is_tracking_enabled")
  activeDays          Json?            @map("active_days")
  created             DateTime         @default(now())
  updated             DateTime         @updatedAt

  campaignLeads                CampaignLead[]
  applications                 JobApplication[]
  leadDraft                    LeadDraft?
  pitches                      PitchTemplate[]
  crmStages                    CrmStage[]
  crmActivities                CrmActivity[]
  crmDeals                     CrmDeal[]
  campaignEmailCredentials     CampaignEmailCredential[]

  @@map("campaigns")
}

// Many-to-many: Campaign <-> EmailCredential (for the `emails` multi-relation)
model CampaignEmailCredential {
  id                String          @id @default(cuid())
  campaignId        String          @map("campaign_id")
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailCredentialId String          @map("email_credential_id")
  emailCredential   EmailCredential @relation(fields: [emailCredentialId], references: [id])

  @@unique([campaignId, emailCredentialId])
  @@map("campaign_email_credentials")
}

// ==========================================
// Email Credentials
// ==========================================
model EmailCredential {
  id              String    @id @default(cuid())
  userId          String?   @map("user_id")
  user            User?     @relation(fields: [userId], references: [id])
  username        String?
  password        String?
  host            String?
  port            Int?
  secure          Boolean   @default(false)
  status          String?   @default("Inactive")
  imapEmail       String?   @map("imap_email")
  imapPassword    String?   @map("imap_password")
  imapHost        String?   @map("imap_host")
  // Not null with a default, so "how many may this mailbox send today" has one
  // answer. It used to be nullable, and each reader supplied its own fallback:
  // the scheduler sized the queue against 20 while a follow-up send allowed 30.
  dailyLimit      Int       @default(20) @map("daily_limit")
  lastCheckedTime DateTime? @map("last_checked_time")
  created         DateTime  @default(now())
  updated         DateTime  @updatedAt

  campaignEmails     CampaignLead[]
  campaignEmailCreds CampaignEmailCredential[]

  @@map("email_credentials")
}

// ==========================================
// Campaign Emails (contacts in a campaign)
// ==========================================
model CampaignLead {
  id                   String           @id @default(cuid())
  // Required: a lead is a person to write to. Both write paths (the composer's
  // commit and the add-lead dialog) reject a contact missing either, and this
  // is the backstop for a path that forgets.
  name                 String
  email                String
  status               String?          @default("PENDING")
  personalization      Json?
  sentAt               DateTime?        @map("sent_at")
  stage                Int?             @default(0)
  campaignId           String?          @map("campaign_id")
  campaign             Campaign?        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  openCount            Int?             @default(0) @map("open_count")
  verified             String?          @default("PENDING")
  verificationMessage  String?          @map("verification_message") @db.Text
  verificationResponse String?          @map("verification_response") @db.Text
  credId               String?          @map("credential_id")
  cred                 EmailCredential? @relation(fields: [credId], references: [id])
  // The company/role this contact was added under. Nullable only so the column
  // could be added to a live table; every write path sets it.
  applicationId        String?          @map("application_id")
  application          JobApplication?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  created              DateTime         @default(now())
  updated              DateTime         @updatedAt

  campaignMessages CampaignMessage[]
  emailOpens       EmailOpen[]
  crmDeals         CrmDeal[]

  @@index([email])
  // Read on every send and on every scheduler tick to size a mailbox's
  // remaining daily allowance.
  @@index([credId])
  // The leads list reads a page of applications and every contact inside them.
  @@index([applicationId])
  @@map("campaign_leads")
}

// ==========================================
// Campaign Messages
// ==========================================
model CampaignMessage {
  id              String         @id @default(cuid())
  text            String?        @db.Text
  pitchId         String?        @map("pitch_id")
  pitch           PitchTemplate?    @relation(fields: [pitchId], references: [id])
  sent            Boolean        @default(false)
  messageId       String?        @map("message_id")
  campaignLeadId  String?        @map("campaign_lead_id")
  campaignLead    CampaignLead? @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)
  timestamp       DateTime?
  created         DateTime       @default(now())
  updated         DateTime       @updatedAt

  // Daily allowance counts sent rows per credential over a rolling day, and
  // reply matching looks a message up by its Message-ID on every inbound mail.
  @@index([campaignLeadId, sent, created])
  @@index([messageId])
  @@map("campaign_messages")
}

// ==========================================
// Campaign Opens (tracking)
// ==========================================
model EmailOpen {
  id              String         @id @default(cuid())
  campaignLeadId  String?        @map("campaign_lead_id")
  // Cascades, like CampaignMessage does. Without it, deleting a lead only set
  // this column to null and left the open events behind forever — they belong
  // to nothing and every analytics query has to exclude them.
  campaignLead    CampaignLead? @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)
  created         DateTime       @default(now())
  updated         DateTime       @updatedAt

  @@map("email_opens")
}

// ==========================================
// Pitches (email templates per campaign stage)
// ==========================================
model PitchTemplate {
  id             String    @id @default(cuid())
  title          String?
  subject        String?
  campaignId     String?   @map("campaign_id")
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stage          Int?
  message        String?   @db.Text
  dynamicSubject String?   @map("dynamic_subject")
  delayDays      Int?      @default(1) @map("delay_days")
  created        DateTime  @default(now())
  updated        DateTime  @updatedAt

  campaignMessages CampaignMessage[]

  @@map("pitch_templates")
}

// ==========================================
// Credit Transactions
// ==========================================
model CreditTransaction {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float?
  timestamp DateTime?
  type      String?
  created   DateTime  @default(now())
  updated   DateTime  @updatedAt

  @@map("credit_transactions")
}

// ==========================================
// CRM Activities
// ==========================================
model CrmActivity {
  id          String    @id @default(cuid())
  dealId      String?   @map("deal_id")
  deal        CrmDeal?  @relation(fields: [dealId], references: [id])
  campaignId  String?   @map("campaign_id")
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  type        String?
  description String?   @db.Text
  fromStageId String?   @map("from_stage_id")
  fromStage   CrmStage? @relation("fromStage", fields: [fromStageId], references: [id])
  toStageId   String?   @map("to_stage_id")
  toStage     CrmStage? @relation("toStage", fields: [toStageId], references: [id])
  created     DateTime  @default(now())
  updated     DateTime  @updatedAt

  @@map("crm_activities")
}

// ==========================================
// CRM Deals
// ==========================================
model CrmDeal {
  id         String         @id @default(cuid())
  leadId     String?        @map("campaign_lead_id")
  lead       CampaignLead? @relation(fields: [leadId], references: [id])
  campaignId String?        @map("campaign_id")
  campaign   Campaign?      @relation(fields: [campaignId], references: [id])
  stageId    String?        @map("stage_id")
  stage      CrmStage?      @relation(fields: [stageId], references: [id])
  created    DateTime       @default(now())
  updated    DateTime       @updatedAt

  activities CrmActivity[]

  @@map("crm_deals")
}

// ==========================================
// CRM Stages
// ==========================================
model CrmStage {
  id         String    @id @default(cuid())
  name       String?
  campaignId String?   @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  order      Int?
  color      String?
  isWon      Boolean   @default(false) @map("is_won")
  isLost     Boolean   @default(false) @map("is_lost")
  created    DateTime  @default(now())
  updated    DateTime  @updatedAt

  deals          CrmDeal[]
  fromActivities CrmActivity[] @relation("fromStage")
  toActivities   CrmActivity[] @relation("toStage")

  @@map("crm_stages")
}

// ==========================================
// Lead List Items
// ==========================================
model LeadListItem {
  id              String    @id @default(cuid())
  leadListId      String?   @map("lead_list_id")
  leadList        LeadList? @relation(fields: [leadListId], references: [id])
  name            String?
  email           String?
  website         String?
  company         String?
  personalization Json?
  created         DateTime  @default(now())
  updated         DateTime  @updatedAt

  @@map("lead_list_items")
}

// ==========================================
// Lead Lists
// ==========================================
model LeadList {
  id          String   @id @default(cuid())
  name        String?
  description String?  @db.Text
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])
  created     DateTime @default(now())
  updated     DateTime @updatedAt

  items LeadListItem[]

  @@map("lead_lists")
}

// ==========================================
// Companies and Applications
// ==========================================
// The billable hierarchy: User -> Company -> JobApplication -> CampaignLead.
//
// Company sits at USER level, not inside a campaign, because the billing unit
// is the company and a user targeting Bayer from two campaigns has still only
// picked one employer. Scoping it per campaign would charge them twice for the
// same decision, and would stop shared company research from ever deduping.
//
// JobApplication is the company/role pairing the composer already writes in
// ("applying at Bayer as Software Engineer"). Roles are free: the quota counts
// Company rows, so applying to two roles at one employer costs one company.
//
// Campaign keeps only what it was ever really for: start, pause and stop of
// sending. It points at applications rather than owning the leads directly.
model Company {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  // Case- and punctuation-folded `name`, and the uniqueness key. "Bayer",
  // "bayer" and "Bayer  " are one company and must consume one slot, so the
  // dedupe cannot be left to whatever the user typed.
  slug String
  // Normalised domain, when known. The key shared company research will cache
  // on, since research is about the employer and not about the user.
  domain String?

  applications JobApplication[]

  // The dedupe that makes the quota honest.
  @@unique([userId, slug])
  @@index([userId])
  @@map("companies")
}

model JobApplication {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  role String?
  // Folded `role`, unique within the company. Null role folds to "" so a
  // company can hold exactly one role-less application rather than an
  // unbounded pile of them.
  roleSlug String @map("role_slug")

  // Which campaign sends for this application. Required: an application only
  // means anything as something a campaign sends for, and the composer always
  // commits into one.
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contacts CampaignLead[]

  created DateTime @default(now())
  updated DateTime @updatedAt

  // Scoped to the campaign, so two campaigns may both work Bayer as Software
  // Engineer. Billing is unaffected: the quota counts Company rows, and both
  // point at the same one.
  @@unique([companyId, roleSlug, campaignId])
  @@index([campaignId])
  @@map("job_applications")
}

// ==========================================
// Lead Drafts
// ==========================================
// The composer's staging area. Rows here are deliberately allowed to be
// invalid — half-typed names, blank emails, columns not filled in yet — because
// a draft that refuses to save what you typed loses your work on close, which
// is the whole thing it exists to prevent.
//
// They are kept out of CampaignLead rather than living there behind a
// status flag: that table is read by the send workers, the rolling daily
// allowance query, analytics and the CRM, and every one of those would need a
// "not a draft" guard forever, including queries written later by someone who
// never heard the rule. A miss there means mailing a prospect an unrendered
// template. Commit is the single gate where validation runs.
//
// There is deliberately no column set stored here. The grid's columns are the
// variables the campaign's pitches reference, derived on every read — storing a
// copy would go stale the moment someone edits a template.
model LeadDraft {
  id         String   @id @default(cuid())
  campaignId String   @unique @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  created    DateTime @default(now())
  updated    DateTime @updatedAt

  rows LeadDraftRow[]

  @@map("lead_drafts")
}


model LeadDraftRow {
  id       String    @id @default(cuid())
  draftId  String    @map("draft_id")
  draft    LeadDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  // Explicit, so a debounced save never reshuffles the grid under the cursor.
  position Int       @default(0)
  name     String?
  email    String?
  // Everything past name/email, mirroring CampaignLead.personalization so
  // commit is a straight copy. Company and role live in here too — they are
  // stated once per group in the UI and written onto every row in it, so the
  // stored shape of a row is unchanged and no endpoint has to know about groups.
  personalization Json?
  created  DateTime @default(now())
  updated  DateTime @updatedAt

  // The grid always reads a whole draft in display order.
  @@index([draftId, position])
  @@map("lead_draft_rows")
}

// ==========================================
// Leads
// ==========================================
model SavedLead {
  id      String   @id @default(cuid())
  userId  String?  @map("user_id")
  user    User?    @relation(fields: [userId], references: [id])
  website String?
  data    Json?
  created DateTime @default(now())
  updated DateTime @updatedAt

  @@map("saved_leads")
}


// ==========================================
// Template Campaign Pitches
// ==========================================
model TemplateCampaignPitch {
  id                 String            @id @default(cuid())
  title              String?
  subject            String?
  campaignTemplateId String?           @map("campaign_template_id")
  campaignTemplate   TemplateCampaign? @relation(fields: [campaignTemplateId], references: [id])
  stage              Int?
  message            String?           @db.Text
  created            DateTime          @default(now())
  updated            DateTime          @updatedAt

  @@map("template_campaign_pitches")
}

// ==========================================
// Template Campaigns
// ==========================================
model TemplateCampaign {
  id                  String   @id @default(cuid())
  title               String?
  maxStageCount       Int?     @map("max_stage_count")
  daysInterval        Int?     @map("days_interval")
  description         String?  @db.Text
  emailDeliveryPeriod String?  @map("email_delivery_period")
  created             DateTime @default(now())
  updated             DateTime @updatedAt

  pitches TemplateCampaignPitch[]

  @@map("template_campaigns")
}

// ==========================================
// Agent Chat
// ==========================================
model AgentChatMessage {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  role      String   // "user" | "assistant" | "tool"
  content   String   @db.Text
  toolName  String?  @map("tool_name")
  userId    String   @map("user_id")
  created   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, threadId])
  @@map("agent_chat_messages")
}

// ==========================================
// WaitlistSignup
// ==========================================
model WaitlistSignup {
  id       String   @id @default(cuid())
  username String?
  email    String
  name     String?
  timezone String?
  created  DateTime @default(now())
  updated  DateTime @updatedAt

  @@index([email])
  @@map("waitlist_signups")
}

